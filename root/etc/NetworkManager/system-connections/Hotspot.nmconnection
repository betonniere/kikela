[connection]
id=Hotspot
uuid=62077887-2837-415c-b208-1fa403535ddf
type=wifi
autoconnect=false
interface-name=wlan0

[wifi]
band=bg
mode=ap
ssid=Kikela

[wifi-security]
key-mgmt=wpa-psk
proto=rsn;
psk=changeme

[ipv4]
address1=10.3.141.1/24
method=shared

[ipv6]
addr-gen-mode=default
method=disabled

[proxy]
