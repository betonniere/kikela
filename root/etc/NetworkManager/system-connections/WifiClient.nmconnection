[connection]
id=WifiClient
uuid=e195daa4-b0dd-4b72-bc4a-1d065830695d
type=wifi
auth-retries=1
autoconnect-retries=1
interface-name=wlan0

[wifi]
mode=infrastructure
ssid=GaletteSaucisse

[wifi-security]
key-mgmt=wpa-psk
psk=changeme

[ipv4]
dhcp-timeout=5
method=auto

[ipv6]
addr-gen-mode=default
method=auto

[proxy]
